{
  "name": "fiducia-marketing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "test": "node --test tests/site-contract.test.mjs tests/commercial-intake-contract.test.mjs",
    "test:browser": "npm run build && node --test --test-concurrency=1 tests/site-*.test.mjs",
    "preview": "astro preview",
    "sync": "npm run build && node scripts/sync-static.mjs",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores",
    "prebuild": "npm run lint:ores"
  },
  "dependencies": {
    "astro": "^7.0.3",
    "@fiducia/interfaces": "file:../fiducia-interfaces"
  },
  "devDependencies": {
    "@fiducia/test-config": "file:../fiducia-test-config",
    "playwright": "^1.61.1",
    "puppeteer": "^25.2.1"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
