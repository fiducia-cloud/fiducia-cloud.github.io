---
// Base HTML shell for every page: sets <head> metadata (title, description, OG
// tags, favicon), renders a shared account bar, and then page content via
// <slot />. Authentication remains entirely on app.fiducia.cloud.
import '../styles/global.css';
import '../styles/account-nav.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fiducia — Consensus & Coordination as a Service',
  description = 'Fiducia is a Raft-based consensus and coordination platform for distributed systems and AI-agent fleets: locks, semaphores, task claims, rate limiting, shared state, elections, KV watches, and reliable cron.',
} = Astro.props;

// Normalize BASE_URL to always end in exactly one slash (Astro returns it
// without a trailing slash when `base` is configured without one).
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';

// The static GitHub Pages site only delegates users to routes already owned by
// the Rust customer app. Shared Auth, Supabase, cookies, MFA, and session
// rotation stay server-side. Commercial-intake discovery remains static and
// routes protected submissions to user.fiducia.cloud.
const accountRoutes = {
  getStarted: `${base}get-started/`,
  login: 'https://app.fiducia.cloud/login',
  signup: 'https://app.fiducia.cloud/app/signup',
  dashboard: 'https://app.fiducia.cloud/app/dashboard',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Privacy hardening: don't leak full URLs/paths to third-party origins.
         HTTP security headers (CSP, X-Content-Type-Options, X-Frame-Options,
         Referrer-Policy) are set by the serving layer (fiducia-customer.rs). -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b1a" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <script
      is:inline
      type="module"
      src="https://ores-chat.github.io/components/v1/ores-chat-footer-link.js"
      integrity="sha256-jtetSlJDWLAWg2+zQIZGUX71OYlIKkZ9sbPnFMup5SE="
      crossorigin="anonymous"
    ></script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <AnnouncementBar
      storageKey="site-announcement:fiducia-cloud:v1"
      message="Happy 2026, y’all!"
      href={`${base}use-cases/`}
      linkLabel="See what we’re building"
      tone="cyan"
    />
    <header class="account-bar">
      <div class="account-bar__inner container">
        <span class="account-bar__context">
          <span class="account-bar__status" aria-hidden="true"></span>
          Customer console
        </span>
        <nav class="account-bar__actions" aria-label="Account">
          <a class="account-bar__link account-bar__link--login" href={accountRoutes.getStarted}>Get started</a>
          <a class="account-bar__link account-bar__link--login" href={accountRoutes.login}>Log in</a>
          <a class="account-bar__link account-bar__link--signup" href={accountRoutes.signup}>Sign up</a>
          <a class="account-bar__link account-bar__link--dashboard" href={accountRoutes.dashboard}>Dashboard</a>
        </nav>
      </div>
    </header>

    <!-- Each page retains its established product navigation and CTA contract.
         account-nav.css offsets that sticky nav below this shared account bar. -->
    <slot />
  </body>
</html>
