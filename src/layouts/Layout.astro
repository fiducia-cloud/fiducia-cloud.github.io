---
// Base HTML shell for every page: sets <head> metadata (title, description, OG
// tags, favicon), renders the shared marketing/account header, and then page
// content via <slot />. Authentication remains entirely on app.fiducia.cloud.
import '../styles/global.css';
import '../styles/account-nav.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fiducia — Consensus & Coordination as a Service',
  description = 'Fiducia is a Raft-based consensus and coordination platform for distributed systems and AI-agent fleets: locks, semaphores, task claims, rate limiting, shared state, elections, KV watches, and reliable cron.',
} = Astro.props;

// Normalize BASE_URL to always end in exactly one slash (Astro returns it
// without a trailing slash when `base` is configured without one).
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';

// The static GitHub Pages site only delegates users to the Rust customer app.
// Shared Auth, Supabase, cookies, MFA, and session rotation stay server-side.
const accountRoutes = {
  login: 'https://app.fiducia.cloud/login',
  signup: 'https://app.fiducia.cloud/signup',
  dashboard: 'https://app.fiducia.cloud/dashboard',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Privacy hardening: don't leak full URLs/paths to third-party origins.
         HTTP security headers (CSP, X-Content-Type-Options, X-Frame-Options,
         Referrer-Policy) are set by the serving layer (fiducia-customer.rs). -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b1a" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <nav class="nav nav--global" aria-label="Primary">
      <div class="nav__inner container">
        <a class="nav__logo" href={base} aria-label="Fiducia home">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <linearGradient id="layout-logo-gradient" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#c084fc" />
                <stop offset="1" stop-color="#6366f1" />
              </linearGradient>
            </defs>
            <circle cx="16" cy="7" r="3.2" fill="url(#layout-logo-gradient)" />
            <circle cx="7" cy="23" r="3.2" fill="url(#layout-logo-gradient)" />
            <circle cx="25" cy="23" r="3.2" fill="url(#layout-logo-gradient)" />
            <path d="M16 7 L7 23 M16 7 L25 23 M7 23 L25 23" stroke="url(#layout-logo-gradient)" stroke-width="1.6" opacity="0.65" />
            <circle cx="16" cy="17.6" r="1.7" fill="#e9d5ff" />
          </svg>
          <span class="nav__logo-text">Fiducia<span class="nav__logo-dim">.cloud</span></span>
        </a>

        <div class="nav__links" aria-label="Product sections">
          <a class="nav__link" href={`${base}#services`}>Services</a>
          <a class="nav__link" href={`${base}#agents`}>AI agents</a>
          <a class="nav__link" href={`${base}#how`}>How it works</a>
          <a class="nav__link" href={`${base}#why`}>Why Raft</a>
        </div>

        <div class="nav__account" role="group" aria-label="Account">
          <a class="nav__account-link nav__account-link--login" href={accountRoutes.login}>Log in</a>
          <a class="btn btn--ghost nav__account-link" href={accountRoutes.signup}>Sign up</a>
          <a class="btn btn--primary nav__account-link" href={accountRoutes.dashboard}>Dashboard</a>
        </div>
      </div>
    </nav>

    <!-- Existing pages still contain their historical per-page nav while they
         are migrated. The wrapper lets account-nav.css hide only that duplicate
         chrome without touching section content or placing auth logic in Pages. -->
    <div class="legacy-page-shell">
      <slot />
    </div>
  </body>
</html>
