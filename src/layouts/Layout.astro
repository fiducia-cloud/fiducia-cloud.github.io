---
// Base HTML shell for every page: sets metadata, renders a shared token-blind
// account bar, and then page content via <slot />. Authentication, Supabase,
// Shared Auth, cookies, MFA, and token rotation stay on app.fiducia.cloud.
import '../styles/global.css';
import '../styles/account-nav.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fiducia — Consensus & Coordination as a Service',
  description = 'Fiducia is a Raft-based consensus and coordination platform for distributed systems and AI-agent fleets: locks, semaphores, task claims, rate limiting, shared state, elections, KV watches, and reliable cron.',
} = Astro.props;

// Normalize BASE_URL to always end in exactly one slash (Astro returns it
// without a trailing slash when `base` is configured without one).
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';

const accountOrigin = 'https://app.fiducia.cloud';
const accountRoutes = {
  login: `${accountOrigin}/login`,
  signup: `${accountOrigin}/app/signup`,
  dashboard: `${accountOrigin}/app/dashboard`,
};
const accountSessionScript = `${base}account-session.js`;

// GitHub Pages does not emit repository-owned response headers. Enforce the
// active-content subset in markup and allow the self-hosted session client to
// contact only the exact Rust customer-app origin.
const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'none'",
  "object-src 'none'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self'",
  "img-src 'self' data:",
  `connect-src ${accountOrigin}`,
  "frame-src 'none'",
  "worker-src 'self'",
  "manifest-src 'self'",
  "form-action 'self'",
  "upgrade-insecure-requests",
].join('; ');
---

<!doctype html>
<html
  lang="en"
  data-account-origin={accountOrigin}
  data-site-base={base}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b1a" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline type="module" src={accountSessionScript}></script>
  </head>
  <body>
    <header class="account-bar">
      <div class="account-bar__inner container">
        <span class="account-bar__context">
          <span class="account-bar__status" aria-hidden="true"></span>
          Customer console
        </span>
        <nav
          class="account-bar__actions"
          aria-label="Account"
          aria-live="polite"
        >
          <a
            class="account-bar__link account-bar__link--primary"
            href={accountOrigin}
            data-account-primary
            data-login-href={accountRoutes.login}
            data-dashboard-href={accountRoutes.dashboard}
            aria-label="Open account"
          >Account</a>
          <a
            class="account-bar__link account-bar__link--signup"
            href={accountRoutes.signup}
            data-account-signup
            hidden
          >Sign up</a>
        </nav>
      </div>
    </header>

    <!-- Each page retains its established product navigation and CTA contract.
         account-nav.css offsets that sticky nav below this shared account bar. -->
    <slot />
  </body>
</html>
