---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const lockRepository = 'https://github.com/ORESoftware/ores-locks-and-leases';
const lockPullRequest = `${lockRepository}/pull/26`;
const validatorRepository = 'https://github.com/ORESoftware/typespec-json-schema-validator';
const validatorRevision = 'dfc28bfc000faba5a963f23c708171dfd5f8debf';

const flow = [
  ['01', 'Acquire Fiducia', 'Obtain a TTL-bounded distributed grant and a monotonically increasing fencing token.'],
  ['02', 'Begin PostgreSQL', 'Open the transaction that will contain every protected database mutation.'],
  ['03', 'Acquire advisory lock', 'Poll pg_try_advisory_xact_lock so lease renewal can interrupt a long wait.'],
  ['04', 'Work and renew', 'Run through the supplied transaction while the outer Fiducia grant is renewed.'],
  ['05', 'Admit commit', 'Require one final renewal and unchanged key, holder, token, TTL, and valid expiry.'],
  ['06', 'Commit and release', 'Commit PostgreSQL, then release Fiducia while preserving cleanup diagnostics.'],
];

const failures = [
  ['contention', 'Fiducia or PostgreSQL is held and nonblocking acquisition was requested.', 'No commit; retry only under caller policy.'],
  ['timeout', 'The configured acquisition budget elapsed.', 'No commit; use bounded backoff.'],
  ['lost_lease', 'Renewal was refused or grant identity changed.', 'Rollback; never continue under the old token.'],
  ['transport', 'Fiducia ownership is ambiguous after a network or HTTP failure.', 'Rollback; reconcile with durable fencing state.'],
  ['database', 'Begin, advisory lock, rollback, commit, or connection failed.', 'Treat commit/cleanup outcomes as potentially uncertain.'],
  ['work', 'The guarded callback failed.', 'Rollback; retry only when operation semantics are idempotent.'],
  ['invalid_plan', 'Timing, backend, or required dependency configuration is unsafe.', 'Nothing is acquired.'],
];
---

<Layout
  title="Maintained Fiducia + PostgreSQL locks — Fiducia API"
  description="Developer guide for maintaining a Fiducia lease around a PostgreSQL transaction advisory lock with fencing and cross-runtime contract verification."
>
  <nav class="api-nav" aria-label="Developer API">
    <div class="container api-nav__inner">
      <a class="api-brand" href={base}>Fiducia<span>.cloud</span></a>
      <div class="api-nav__links">
        <a href={`${base}use-cases/`}>Use cases</a>
        <a href={lockRepository}>Source</a>
        <a href={lockPullRequest}>Candidate PR</a>
      </div>
    </div>
  </nav>

  <main>
    <section class="api-hero">
      <div class="container api-hero__grid">
        <div>
          <p class="eyebrow">Public API guide · DEN-2050</p>
          <h1>Keep distributed authority through the database commit.</h1>
          <p class="hero-copy">
            Compose a Fiducia lease with a PostgreSQL transaction-scoped advisory lock,
            renew while the transaction waits and works, then require one final authority
            check before commit.
          </p>
          <div class="hero-actions">
            <a class="btn btn--primary" href={lockPullRequest}>Review the implementation</a>
            <a class="text-link" href={validatorRepository}>Review contract verification</a>
          </div>
        </div>
        <aside class="status-panel" aria-label="API status">
          <p class="status-panel__label">Promotion state</p>
          <p class="status-panel__value">Candidate API</p>
          <p>
            The maintained path is tracked in pull request #26. Confirm the package revision
            and exact-head checks before production use.
          </p>
          <dl>
            <div><dt>Outer authority</dt><dd>Fiducia lease</dd></div>
            <div><dt>Inner exclusion</dt><dd>PostgreSQL xact advisory lock</dd></div>
            <div><dt>Primary runtime</dt><dd>Rust + SeaORM</dd></div>
            <div><dt>Parity runtimes</dt><dd>Go, TypeScript, Dart, Gleam</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="principles" aria-labelledby="principles-title">
      <div class="container">
        <p class="eyebrow">Two boundaries, one routine</p>
        <h2 id="principles-title">Distributed ownership is not database ownership.</h2>
        <div class="principle-grid">
          <article>
            <span>Fiducia</span>
            <h3>Cross-host authority</h3>
            <p>
              A TTL-bounded lease coordinates processes, hosts, clusters, and regions. Each
              new grant carries a higher fencing token.
            </p>
          </article>
          <article>
            <span>PostgreSQL</span>
            <h3>Database-local serialization</h3>
            <p>
              <code>pg_advisory_xact_lock</code> serializes cooperating transactions in one
              database and is released by commit or rollback.
            </p>
          </article>
          <article>
            <span>Protected resource</span>
            <h3>Durable stale-writer rejection</h3>
            <p>
              The mutation must atomically reject a fencing token that is not greater than
              the resource’s stored watermark.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="flow-section" aria-labelledby="flow-title">
      <div class="container">
        <p class="eyebrow">Maintained transaction flow</p>
        <h2 id="flow-title">Renew during contention and work. Renew again before commit.</h2>
        <ol class="flow-list">
          {flow.map(([number, title, body]) => (
            <li>
              <span class="flow-number">{number}</span>
              <div><h3>{title}</h3><p>{body}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="warning-section">
      <div class="container warning-card">
        <div class="warning-icon" aria-hidden="true">!</div>
        <div>
          <p class="eyebrow">Critical boundary</p>
          <h2>Final renewal and PostgreSQL commit are not atomic.</h2>
          <p>
            They occur in different systems. A crash or partition can happen between them.
            The maintained routine reduces the stale-commit window, but it does not replace
            resource-side fencing, idempotency, or reconciliation.
          </p>
        </div>
      </div>
    </section>

    <section class="code-section" aria-labelledby="code-title">
      <div class="container code-grid">
        <div>
          <p class="eyebrow">Rust reference path</p>
          <h2 id="code-title">Use the transaction supplied to guarded work.</h2>
          <p>
            Every database effect that relies on rollback and advisory exclusion must execute
            through <code>guarded.txn</code>. External HTTP calls, object writes, and messages
            are not rolled back by PostgreSQL.
          </p>
        </div>
        <pre aria-label="Rust maintained transaction example"><code>{`let result = with_maintained_xact_lock(
    &key,
    true,
    &AcquireOptions::default(),
    &LeaseMaintenanceOptions::default(),
    &fiducia,
    &database,
    |guarded| Box::pin(async move {
        let txn = guarded.txn.expect("transaction");
        txn.execute(fenced_statement).await?;
        Ok::<_, sea_orm::DbErr>(())
    }),
).await?;`}</code></pre>
      </div>
    </section>

    <section class="fence-section" aria-labelledby="fence-title">
      <div class="container code-grid code-grid--reverse">
        <pre aria-label="PostgreSQL fencing update"><code>{`UPDATE protected_resource
SET payload = $2,
    fencing_token = $1
WHERE resource_id = $3
  AND fencing_token < $1;`}</code></pre>
        <div>
          <p class="eyebrow">Mandatory resource fencing</p>
          <h2 id="fence-title">Advance the watermark in the same statement.</h2>
          <p>
            Zero affected rows means the caller did not advance the resource. Do not read the
            watermark and then perform an unconditional write. Store operation identity and a
            canonical payload digest when equal-token replay must be distinguished from token reuse.
          </p>
          <p>
            Carry the full unsigned 64-bit fencing token as canonical decimal text across JSON
            boundaries. JavaScript callers must not convert it to <code>number</code>.
          </p>
        </div>
      </div>
    </section>

    <section class="failure-section" aria-labelledby="failure-title">
      <div class="container">
        <p class="eyebrow">Structured failures</p>
        <h2 id="failure-title">Fail closed, then reconcile deliberately.</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Kind</th><th>Meaning</th><th>Commit and retry posture</th></tr></thead>
            <tbody>
              {failures.map(([kind, meaning, posture]) => (
                <tr><td><code>{kind}</code></td><td>{meaning}</td><td>{posture}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="contract-section" aria-labelledby="contract-title">
      <div class="container contract-grid">
        <div>
          <p class="eyebrow">Cross-runtime contract enforcement</p>
          <h2 id="contract-title">Independent authorities. Exact evidence bindings.</h2>
          <p>
            TypeSpec and hand-authored JSON Schema Draft 2020-12 remain peer authorities.
            Neither is generated from the other and neither wins by precedence.
          </p>
          <p>
            TypeSpec-generated Schema B, Contract IR, generated clients, and runtime receipts
            are comparison evidence only.
          </p>
        </div>
        <div class="contract-list">
          <article><strong>Parity</strong><span><code>tjsv check</code> compares both authored peers and runs differential probes.</span></article>
          <article><strong>Consumer binding</strong><span><code>tjsv verify-ir</code> binds Contract IR to current source and its parity receipt.</span></article>
          <article><strong>Runtime admission</strong><span><code>verifyLanguageBoundaries</code> binds Rust, Go, TypeScript, Dart, and Gleam evidence to one exact revision.</span></article>
          <article><strong>Negative canary</strong><span>A stale parity-receipt ID must be rejected with <code>stopped_for_evaluation</code>.</span></article>
        </div>
      </div>
      <div class="container revision-note">
        <span>Reviewed validator revision</span>
        <code>{validatorRevision}</code>
      </div>
    </section>

    <section class="admission-section" aria-labelledby="admission-title">
      <div class="container">
        <p class="eyebrow">Merge admission</p>
        <h2 id="admission-title">Evidence required on the exact final head.</h2>
        <ul class="check-grid">
          <li>Rust formatting, no-default-feature build, Clippy, and full tests</li>
          <li>Live PostgreSQL contention, handoff, renewal-loss, rollback, and commit tests</li>
          <li>RustSec production dependency audit</li>
          <li>Go formatting, vet, and tests</li>
          <li>TypeScript build and Node runtime tests</li>
          <li>Dart formatting, analysis, and tests</li>
          <li>Gleam formatting and BEAM tests</li>
          <li>Both TypeSpec and JSON Schema bundles passing TJSV</li>
          <li>Official five-runtime boundary verification and stale-receipt canary</li>
          <li>Generated zed-pkg consumer verification</li>
        </ul>
      </div>
    </section>

    <section class="closing-section">
      <div class="container closing-card">
        <div>
          <p class="eyebrow">Source-first review</p>
          <h2>Inspect the implementation and retained evidence.</h2>
          <p>
            This page explains the contract; source, tests, and exact-head receipts decide
            whether a revision is admissible.
          </p>
        </div>
        <div class="closing-actions">
          <a class="btn btn--primary" href={lockPullRequest}>Open lock PR #26</a>
          <a class="btn btn--secondary" href={validatorRepository}>Open TJSV</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(body) { background: #070b1a; }
  .api-nav { position: sticky; top: var(--account-bar-height, 42px); z-index: 20; border-bottom: 1px solid rgba(148,163,184,.16); background: rgba(7,11,26,.92); backdrop-filter: blur(18px); }
  .api-nav__inner { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .api-brand { color: #f8fafc; font-size: 1.16rem; font-weight: 800; }
  .api-brand span { color: #67e8f9; }
  .api-nav__links { display: flex; align-items: center; gap: 24px; }
  .api-nav__links a { color: #cbd5e1; font-size: .92rem; }
  .api-nav__links a:hover { color: #67e8f9; }
  .api-hero { padding: 96px 0 82px; background: radial-gradient(circle at 18% 12%, rgba(14,165,233,.22), transparent 34%), radial-gradient(circle at 82% 18%, rgba(124,58,237,.2), transparent 32%); }
  .api-hero__grid { display: grid; grid-template-columns: minmax(0,1.45fr) minmax(300px,.65fr); gap: 64px; align-items: center; }
  .eyebrow { margin: 0 0 14px; color: #67e8f9; font-size: .76rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  h1 { max-width: 920px; margin: 0; color: #f8fafc; font-size: clamp(3rem,7vw,6.4rem); line-height: .94; letter-spacing: -.06em; }
  h2 { margin: 0; color: #f8fafc; font-size: clamp(2rem,4vw,3.7rem); line-height: 1.05; letter-spacing: -.04em; }
  h3 { margin: 8px 0 10px; color: #f8fafc; }
  p { color: #aebbd0; line-height: 1.72; }
  .hero-copy { max-width: 820px; margin: 28px 0 0; color: #d3dbea; font-size: clamp(1.08rem,2vw,1.34rem); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 34px; }
  .text-link { color: #a5f3fc; font-weight: 700; }
  .status-panel { padding: 28px; border: 1px solid rgba(103,232,249,.24); border-radius: 22px; background: rgba(15,23,42,.76); box-shadow: 0 24px 70px rgba(0,0,0,.22); }
  .status-panel__label { margin: 0; color: #94a3b8; font-size: .76rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .status-panel__value { margin: 8px 0 10px; color: #facc15; font-size: 1.5rem; font-weight: 850; }
  dl { display: grid; gap: 12px; margin: 24px 0 0; }
  dl div { display: flex; justify-content: space-between; gap: 20px; padding-top: 12px; border-top: 1px solid rgba(148,163,184,.14); }
  dt { color: #94a3b8; } dd { margin: 0; color: #e2e8f0; text-align: right; }
  .principles, .flow-section, .code-section, .fence-section, .failure-section, .contract-section, .admission-section { padding: 88px 0; }
  .principle-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 22px; margin-top: 40px; }
  .principle-grid article { padding: 28px; border: 1px solid rgba(148,163,184,.15); border-radius: 20px; background: rgba(15,23,42,.58); }
  .principle-grid article > span { color: #818cf8; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; font-size: .78rem; font-weight: 800; text-transform: uppercase; }
  .flow-section { background: rgba(15,23,42,.32); }
  .flow-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; margin: 40px 0 0; padding: 0; list-style: none; }
  .flow-list li { display: flex; gap: 20px; padding: 24px; border: 1px solid rgba(148,163,184,.14); border-radius: 18px; background: rgba(7,11,26,.55); }
  .flow-number { color: #67e8f9; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; font-weight: 900; }
  .flow-list p { margin: 0; }
  .warning-section { padding: 40px 0; }
  .warning-card { display: grid; grid-template-columns: auto 1fr; gap: 24px; padding: 32px; border: 1px solid rgba(250,204,21,.3); border-radius: 22px; background: linear-gradient(135deg,rgba(120,53,15,.3),rgba(30,41,59,.72)); }
  .warning-icon { display: grid; place-items: center; width: 50px; height: 50px; border-radius: 50%; background: rgba(250,204,21,.16); color: #fde047; font-size: 1.5rem; font-weight: 900; }
  .code-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 48px; align-items: center; }
  .code-grid--reverse { grid-template-columns: 1.2fr .8fr; }
  pre { overflow-x: auto; margin: 0; padding: 28px; border: 1px solid rgba(103,232,249,.2); border-radius: 20px; background: #020617; box-shadow: inset 0 1px 0 rgba(255,255,255,.04); }
  code { color: #c4b5fd; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; }
  pre code { color: #dbeafe; line-height: 1.7; }
  .fence-section { background: rgba(15,23,42,.32); }
  .table-wrap { overflow-x: auto; margin-top: 38px; border: 1px solid rgba(148,163,184,.16); border-radius: 20px; }
  table { width: 100%; border-collapse: collapse; min-width: 760px; background: rgba(15,23,42,.52); }
  th, td { padding: 18px 20px; border-bottom: 1px solid rgba(148,163,184,.12); text-align: left; vertical-align: top; }
  th { color: #cbd5e1; font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
  td { color: #aebbd0; line-height: 1.55; }
  tbody tr:last-child td { border-bottom: 0; }
  .contract-section { background: radial-gradient(circle at 75% 20%,rgba(124,58,237,.16),transparent 35%); }
  .contract-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 48px; }
  .contract-list { display: grid; gap: 14px; }
  .contract-list article { display: grid; grid-template-columns: 160px 1fr; gap: 18px; padding: 20px; border: 1px solid rgba(148,163,184,.15); border-radius: 16px; background: rgba(15,23,42,.62); }
  .contract-list strong { color: #f8fafc; } .contract-list span { color: #aebbd0; line-height: 1.55; }
  .revision-note { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; margin-top: 34px; padding: 18px 22px; border: 1px solid rgba(129,140,248,.2); border-radius: 14px; background: rgba(30,27,75,.35); color: #cbd5e1; }
  .revision-note code { overflow-wrap: anywhere; }
  .check-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px; margin: 38px 0 0; padding: 0; list-style: none; }
  .check-grid li { position: relative; padding: 18px 18px 18px 48px; border: 1px solid rgba(148,163,184,.14); border-radius: 16px; color: #cbd5e1; background: rgba(15,23,42,.5); }
  .check-grid li::before { content: '✓'; position: absolute; left: 18px; color: #67e8f9; font-weight: 900; }
  .closing-section { padding: 20px 0 96px; }
  .closing-card { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 36px; border: 1px solid rgba(103,232,249,.22); border-radius: 24px; background: linear-gradient(135deg,rgba(15,23,42,.85),rgba(30,27,75,.55)); }
  .closing-card > div:first-child { max-width: 760px; }
  .closing-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn--secondary { border: 1px solid rgba(148,163,184,.3); color: #e2e8f0; }
  @media (max-width: 960px) {
    .api-hero__grid, .code-grid, .code-grid--reverse, .contract-grid { grid-template-columns: 1fr; }
    .principle-grid { grid-template-columns: 1fr; }
    .closing-card { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 720px) {
    .api-nav__links a:not(:last-child) { display: none; }
    .api-hero { padding-top: 70px; }
    .flow-list, .check-grid { grid-template-columns: 1fr; }
    .warning-card { grid-template-columns: 1fr; }
    .contract-list article { grid-template-columns: 1fr; gap: 8px; }
    h1 { font-size: clamp(2.7rem,14vw,4.5rem); }
  }
</style>
