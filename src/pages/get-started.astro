---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const journeys = [
  {
    href: `${base}quote/`,
    label: 'Request a quote',
    title: 'Plan scope and budget',
    body: 'Share deployment, environment, throughput, retention, capability, onboarding, and support preferences for a non-binding estimate.',
    destination: 'https://user.fiducia.cloud/quote',
  },
  {
    href: `${base}pre-interest/`,
    label: 'Register interest',
    title: 'Start a low-friction conversation',
    body: 'Tell us the use case, expected timing, budget band, support preference, and coordination primitives you are evaluating.',
    destination: 'https://user.fiducia.cloud/pre-interest',
  },
  {
    href: `${base}apply/`,
    label: 'Enterprise application',
    title: 'Define the complete operating need',
    body: 'Document topology, scale, consistency, recovery, security, support, procurement, B2B contract, billing, and requested SLO/SLA requirements.',
    destination: 'https://user.fiducia.cloud/apply',
  },
];
---

<Layout
  title="Get started with Fiducia"
  description="Choose a protected Fiducia quote, pre-interest, or enterprise application journey."
>
  <nav class="start-nav" aria-label="Product">
    <div class="container start-nav__inner">
      <a class="start-brand" href={base}>Fiducia<span>.cloud</span></a>
      <a href={`${base}use-cases/`}>Use cases</a>
    </div>
  </nav>

  <main>
    <section class="start-hero">
      <div class="container">
        <p class="start-eyebrow">Commercial intake</p>
        <h1>Choose the right path into Fiducia</h1>
        <p class="start-summary">
          Begin with a non-binding estimate, register early interest, or submit a detailed
          enterprise application. Protected forms live on <strong>user.fiducia.cloud</strong>;
          this public site never collects customer or procurement data.
        </p>
      </div>
    </section>

    <section class="start-grid-section">
      <div class="container start-grid">
        {journeys.map((journey, index) => (
          <article class="start-card">
            <span class="start-card__index">0{index + 1}</span>
            <h2>{journey.title}</h2>
            <p>{journey.body}</p>
            <div class="start-card__actions">
              <a href={journey.href}>Review what is requested</a>
              <a class="btn btn--primary" href={journey.destination}>{journey.label}</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="start-scope">
      <div class="container start-scope__grid">
        <article>
          <p class="start-eyebrow">Support and service levels</p>
          <h2>Describe the operating relationship</h2>
          <p>
            The enterprise application covers business-hours, 24×5, and 24×7 preferences;
            support channels; onboarding and migration assistance; architecture review;
            training; named technical contacts; technical account management; incident
            bridges; response targets; maintenance notice; measurement windows; error-budget
            policy; requested availability; and service-credit preferences.
          </p>
        </article>
        <article>
          <p class="start-eyebrow">B2B contracting</p>
          <h2>Prepare the commercial review</h2>
          <p>
            Capture MSA, SOW, order form, SLA, DPA, NDA, AUP, security-addendum, public-sector,
            customer-paper, billing, purchase-order, payment-term, renewal, termination,
            liability, indemnity, insurance, audit, data-processing, governing-law, venue,
            and intellectual-property requirements without treating requested language as accepted.
          </p>
        </article>
      </div>
    </section>

    <section class="start-boundary">
      <div class="container start-boundary__inner">
        <div>
          <p class="start-eyebrow">Evaluation boundary</p>
          <h2>No hidden commitment</h2>
          <p>
            A quote is not an offer or capacity reservation. A requested SLO is not a
            contractual SLA. Compliance selections do not assert certification. Pricing,
            support, security, and customer-paper requests require human review and a signed
            order form before they become binding.
          </p>
        </div>
        <a class="btn btn--primary" href="https://user.fiducia.cloud/pre-interest">
          Register pre-interest
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .start-nav {
    position: sticky;
    top: var(--account-bar-height, 42px);
    z-index: 20;
    border-bottom: 1px solid rgba(148, 163, 184, 0.16);
    background: rgba(7, 11, 26, 0.9);
    backdrop-filter: blur(16px);
  }

  .start-nav__inner {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .start-brand {
    color: #f8fafc;
    font-size: 1.16rem;
    font-weight: 800;
  }

  .start-brand span,
  .start-nav a:last-child {
    color: #a78bfa;
  }

  .start-hero {
    padding: 96px 0 68px;
    background:
      radial-gradient(circle at 24% 10%, rgba(124, 58, 237, 0.22), transparent 35%),
      radial-gradient(circle at 80% 20%, rgba(59, 130, 246, 0.15), transparent 34%);
  }

  .start-eyebrow {
    margin: 0 0 14px;
    color: #a78bfa;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 920px;
    margin: 0;
    color: #f8fafc;
    font-size: clamp(2.7rem, 7vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .start-summary {
    max-width: 840px;
    margin: 28px 0 0;
    color: #cbd5e1;
    font-size: clamp(1.08rem, 2.1vw, 1.34rem);
    line-height: 1.75;
  }

  .start-grid-section {
    padding: 72px 0;
  }

  .start-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .start-card,
  .start-scope article {
    padding: 30px;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 20px;
    background: rgba(15, 23, 42, 0.58);
  }

  .start-card__index {
    color: #818cf8;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.82rem;
    font-weight: 800;
  }

  h2 {
    margin: 14px 0 12px;
    color: #f8fafc;
    font-size: 1.4rem;
  }

  .start-card p,
  .start-scope p,
  .start-boundary p {
    color: #aebbd0;
    line-height: 1.72;
  }

  .start-card__actions {
    display: grid;
    gap: 14px;
    margin-top: 24px;
  }

  .start-card__actions > a:first-child {
    color: #c4b5fd;
  }

  .start-card__actions .btn {
    justify-content: center;
  }

  .start-scope {
    padding: 0 0 72px;
  }

  .start-scope__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .start-boundary {
    padding: 0 0 88px;
  }

  .start-boundary__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    padding: 34px;
    border: 1px solid rgba(96, 165, 250, 0.24);
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.82), rgba(30, 27, 75, 0.58));
  }

  .start-boundary__inner > div {
    max-width: 780px;
  }

  @media (max-width: 920px) {
    .start-grid,
    .start-scope__grid {
      grid-template-columns: 1fr;
    }

    .start-boundary__inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 620px) {
    .start-hero {
      padding-top: 64px;
    }

    .start-boundary .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
